6-9.4 33.9 0l96.4 96.4 96.4-96.4c9.4-9.4 24.6-9.4 33.9 0l22.6 22.6c9.4 9.4 9.4 24.6 0 33.9l-136 136c-9.2 9.4-24.4 9.4-33.8 0z\"><\/path><\/svg><\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">Why we started HCCF<\/a>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<div id=\"elementor-tab-content-5511\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"1\" role=\"region\" aria-labelledby=\"elementor-tab-title-5511\"><p><span style=\"font-weight: 400;\">The Human-Centered Computing Foundation was created to address a critical deficit in the modern technology landscape. The prevailing economic models of the digital age\u00a0 surveillance capitalism and entrapping SaaS platforms prioritize corporate shareholder value over the fundamental needs, privacy, and autonomy of the individual.<\/span><\/p><p><span style=\"font-weight: 400;\">These models capture the value that users create and provide, and rather than redirecting it back to the user, they extract it solely for corporate benefit. HCCF exists to recalibrate this balance.<\/span><\/p><p><span style=\"font-weight: 400;\">Our founders bring an international perspective\u00a0 combining the experience of building technology in the United States with insights from Brazil and beyond\u00a0 reflecting our conviction that a truly human-centered ecosystem must represent the full diversity of humanity.<\/span><\/p><\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<div id=\"elementor-tab-title-5512\" class=\"elementor-tab-title\" data-tab=\"2\" role=\"button\" aria-controls=\"elementor-tab-content-5512\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-right\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><svg class=\"e-font-icon-svg e-fas-angle-right\" viewBox=\"0 0 256 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M224.3 273l-136 136c-9.4 9.4-24.6 9.4-33.9 0l-22.6-22.6c-9.4-9.4-9.4-24.6 0-33.9l96.4-96.4-96.4-96.4c-9.4-9.4-9.4-24.6 0-33.9L54.3 103c9.4-9.4 24.6-9.4 33.9 0l136 136c9.5 9.4 9.5 24.6.1 34z\"><\/path><\/svg><\/span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><svg class=\"e-font-icon-svg e-fas-angle-down\" viewBox=\"0 0 320 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4 24.6-9.4 33.9 0l96.4 96.4 96.4-96.4c9.4-9.4 24.6-9.4 33.9 0l22.6 22.6c9.4 9.4 9.4 24.6 0 33.9l-136 136c-9.2 9.4-24.4 9.4-33.8 0z\"><\/path><\/svg><\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">Built for mission, not margin<\/a>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<div id=\"elementor-tab-content-5512\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"2\" role=\"region\" aria-labelledby=\"elementor-tab-title-5512\"><p><span style=\"font-weight: 400;\">As a 501(c)(3) nonprofit, every decision we make is guided by mission rather than financial return. Our legal structure is a feature, not an afterthought \u2014 it signals that we cannot and will not compromise our principles for commercial convenience.<\/span><\/p><p><span style=\"font-weight: 400;\">We are governed by a board of directors and operate as a fully remote organization, enabling us to draw on global talent and perspectives. Founders work without salary in this initial phase to direct maximum resources toward mission-critical activities.<\/span><\/p><\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t\t<script type=\"application\/ld+json\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Why we started HCCF\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">The Human-Centered Computing Foundation was created to address a critical deficit in the modern technology landscape. The prevailing economic models of the digital age\\u00a0 surveillance capitalism and entrapping SaaS platforms prioritize corporate shareholder value over the fundamental needs, privacy, and autonomy of the individual.<\\\/span><\\\/p><p><span style=\\\"font-weight: 400;\\\">These models capture the value that users create and provide, and rather than redirecting it back to the user, they extract it solely for corporate benefit. HCCF exists to recalibrate this balance.<\\\/span><\\\/p><p><span style=\\\"font-weight: 400;\\\">Our founders bring an international perspective\\u00a0 combining the experience of building technology in the United States with insights from Brazil and beyond\\u00a0 reflecting our conviction that a truly human-centered ecosystem must represent the full diversity of humanity.<\\\/span><\\\/p>\"}},{\"@type\":\"Question\",\"name\":\"Built for mission, not margin\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">As a 501(c)(3) nonprofit, every decision we make is guided by mission rather than financial return. Our legal structure is a feature, not an afterthought \\u2014 it signals that we cannot and will not compromise our principles for commercial convenience.<\\\/span><\\\/p><p><span style=\\\"font-weight: 400;\\\">We are governed by a board of directors and operate as a fully remote organization, enabling us to draw on global talent and perspectives. Founders work without salary in this initial phase to direct maximum resources toward mission-critical activities.<\\\/span><\\\/p>\"}}]}<\/script>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t<div class=\"elementor-element elementor-element-8a88430 e-flex e-con-boxed e-con e-parent\" data-id=\"8a88430\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot